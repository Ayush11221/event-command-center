generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ContactType {
  EMAIL
  PHONE
}

enum ProofPurpose {
  ACCOUNT
  GUEST_OWNERSHIP
}

enum StaffRole {
  EVENT_ADMIN
  GATE_SECURITY
  VOLUNTEER
}

enum AuditActorKind {
  ACCOUNT
  GUEST
  SYSTEM
}

enum EventState {
  DRAFT
  PUBLISHED
  LIVE
  COMPLETED
  CANCELLED
}

enum EventVisibility {
  PUBLIC
  PRIVATE
}

enum CommandReplayStatus {
  PENDING
  COMPLETED
}

enum RegistrationState {
  REGISTERED
  CANCELLED
}

enum ScanOutcome {
  ACCEPTED
  REJECTED
}

enum AttendanceKind {
  CHECK_IN
}

enum VolunteerTaskStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Binding foreign keys and lifecycle guards are SQL-owned, as for certificate work.
model VolunteerTask {
  id                  String              @id @default(uuid()) @db.Uuid
  eventId             String              @db.Uuid
  createdByUserId     String              @db.Uuid
  creationKeyHash     String              @db.Char(64)
  assignedVolunteerId String              @db.Uuid
  assignedRoleGrantId String              @db.Uuid
  title               String              @db.VarChar(160)
  instructions        String              @db.Text
  location            String?             @db.VarChar(240)
  startsAt            DateTime?           @db.Timestamptz(3)
  endsAt              DateTime?           @db.Timestamptz(3)
  status              VolunteerTaskStatus @default(ASSIGNED)
  revision            Int                 @default(1)
  createdAt           DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime            @default(now()) @db.Timestamptz(3)
  cancelledAt         DateTime?           @db.Timestamptz(3)
  cancelledByUserId   String?             @db.Uuid
  cancellationReason  String?             @db.VarChar(500)

  @@unique([eventId, createdByUserId, creationKeyHash])
  @@index([eventId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([eventId, assignedVolunteerId, createdAt(sort: Desc), id(sort: Desc)])
}

model User {
  id                     String                 @id @default(uuid()) @db.Uuid
  organizerCapable       Boolean                @default(false)
  createdAt              DateTime               @default(now()) @db.Timestamptz(3)
  contacts               VerifiedContact[]
  sessions               Session[]
  ownedEvents            Event[]                @relation("EventOwner")
  assignments            EventRoleAssignment[]  @relation("AssignmentTarget")
  grantedAssignments     EventRoleAssignment[]  @relation("AssignmentGrantActor")
  revokedAssignments     EventRoleAssignment[]  @relation("AssignmentRevokeActor")
  commandReplays         CommandReplay[]
  registrations          Registration[]         @relation("RegistrationOwner")
  cancelledRegistrations Registration[]         @relation("RegistrationCancelActor")
  scanDecisions          ScanDecision[]
  attendanceTransitions  AttendanceTransition[]
}

model VerifiedContact {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @db.Uuid
  type       ContactType
  lookupHash String      @db.Char(64)
  encrypted  String      @db.Text
  verifiedAt DateTime    @db.Timestamptz(3)
  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([type, lookupHash])
  @@index([userId])
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt         DateTime  @db.Timestamptz(3)
  revokedAt         DateTime? @db.Timestamptz(3)
  absoluteExpiresAt DateTime? @db.Timestamptz(3)
  renewalHash       String?   @db.Char(64)
  renewalVersion    Int       @default(0)
  renewedAt         DateTime? @db.Timestamptz(3)
  user              User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
}

model OtpRateLimitBucket {
  category    String   @db.VarChar(8)
  key         String   @db.Char(64)
  windowStart DateTime @db.Timestamptz(3)
  expiresAt   DateTime @db.Timestamptz(3)
  count       Int

  @@id([category, key, windowStart])
  @@index([expiresAt])
}

model OtpChallenge {
  id                String       @id @default(uuid()) @db.Uuid
  contactType       ContactType
  contactLookupHash String       @db.Char(64)
  purpose           ProofPurpose
  contextEventId    String?      @db.Uuid
  codeHash          String       @db.Char(64)
  attempts          Int          @default(0)
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  expiresAt         DateTime     @db.Timestamptz(3)
  lastSentAt        DateTime     @db.Timestamptz(3)
  deliveredAt       DateTime?    @db.Timestamptz(3)
  consumedAt        DateTime?    @db.Timestamptz(3)
  lockedAt          DateTime?    @db.Timestamptz(3)

  @@index([contactType, contactLookupHash, createdAt(sort: Desc)])
}

model Event {
  id                               String                 @id @default(uuid()) @db.Uuid
  ownerUserId                      String                 @db.Uuid
  state                            EventState             @default(DRAFT)
  name                             String                 @db.VarChar(200)
  description                      String?                @db.Text
  publicLocation                   String?                @db.VarChar(500)
  imageUrl                         String?                @db.Text
  category                         String?                @db.VarChar(100)
  tags                             String[]               @default([])
  startAt                          DateTime?              @db.Timestamptz(3)
  endAt                            DateTime?              @db.Timestamptz(3)
  timeZone                         String?                @db.VarChar(100)
  visibility                       EventVisibility?
  registrationCapacity             Int?
  registrationOpensAt              DateTime?              @db.Timestamptz(3)
  registrationClosesAt             DateTime?              @db.Timestamptz(3)
  registrationCancellationCutoffAt DateTime?              @db.Timestamptz(3)
  registrationManuallyClosed       Boolean                @default(false)
  checkoutEnabled                  Boolean                @default(false)
  revision                         Int                    @default(1)
  publishedAt                      DateTime?              @db.Timestamptz(3)
  createdAt                        DateTime               @default(now()) @db.Timestamptz(3)
  owner                            User                   @relation("EventOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  gates                            Gate[]
  assignments                      EventRoleAssignment[]
  privateAccessLinks               PrivateAccessLink[]
  registrations                    Registration[]
  scanDecisions                    ScanDecision[]
  forecastRuns                     ForecastRun[]
  attendanceTransitions            AttendanceTransition[]

  @@index([ownerUserId, createdAt(sort: Desc), id(sort: Desc)])
}

// Legacy-table foreign keys for certificates are SQL-owned to preserve Registration.
enum CertificateStatus {
  ISSUED
  REVOKED
}

enum CertificateIssueWorkStatus {
  PENDING
  COMPLETED
  FAILED
}

model CertificateRecipientName {
  registrationId String   @id @db.Uuid
  eventId        String   @db.Uuid
  name           String   @db.VarChar(100)
  revision       Int      @default(1)
  updatedAt      DateTime @default(now()) @db.Timestamptz(3)
}

model Certificate {
  id                     String            @id @db.Uuid
  registrationId         String            @unique @db.Uuid
  eventId                String            @db.Uuid
  status                 CertificateStatus @default(ISSUED)
  certificateNumber      String            @unique @db.Char(36)
  recipientName          String            @db.VarChar(100)
  templateId             String            @db.VarChar(16)
  templateVersion        Int               @db.SmallInt
  fontId                 String            @db.VarChar(8)
  eligibilityRuleVersion String            @db.VarChar(40)
  attendanceTransitionId String            @db.Uuid
  firstAcceptedCheckInAt DateTime          @db.Timestamptz(3)
  pdfBytes               Bytes
  pdfSha256              String            @db.Char(64)
  issuedByUserId         String            @db.Uuid
  issuedAt               DateTime          @db.Timestamptz(3)
  revokedByUserId        String?           @db.Uuid
  revokedAt              DateTime?         @db.Timestamptz(3)
  revokeReason           String?           @db.VarChar(200)

  @@index([eventId, issuedAt(sort: Desc), id(sort: Desc)])
}

model CertificateIssueWork {
  id                     String                     @id @default(uuid()) @db.Uuid
  registrationId         String                     @unique @db.Uuid
  eventId                String                     @db.Uuid
  status                 CertificateIssueWorkStatus @default(PENDING)
  commandReplayId        String                     @unique @db.Uuid
  requestedByUserId      String                     @db.Uuid
  executionByUserId      String                     @db.Uuid
  executionSessionId     String                     @db.Uuid
  executionBatchId       String?                    @db.Uuid
  correlationId          String                     @db.VarChar(64)
  templateId             String                     @db.VarChar(16)
  templateVersion        Int                        @db.SmallInt
  fontId                 String                     @db.VarChar(8)
  eligibilityRuleVersion String                     @db.VarChar(40)
  attendanceTransitionId String                     @db.Uuid
  firstAcceptedCheckInAt DateTime                   @db.Timestamptz(3)
  recipientName          String                     @db.VarChar(100)
  recipientNameRevision  Int
  eventName              String                     @db.VarChar(200)
  eventStartAt           DateTime                   @db.Timestamptz(3)
  eventTimeZone          String                     @db.VarChar(100)
  generationCycle        Int                        @default(1)
  attemptCount           Int                        @default(0)
  fencingToken           BigInt                     @default(0)
  claimToken             String?                    @db.Uuid
  leaseExpiresAt         DateTime?                  @db.Timestamptz(3)
  retryAt                DateTime?                  @default(now()) @db.Timestamptz(3)
  generationStartedAt    DateTime?                  @db.Timestamptz(3)
  lastErrorCode          String?                    @db.VarChar(80)
  lastErrorAt            DateTime?                  @db.Timestamptz(3)
  completedCertificateId String?                    @unique @db.Uuid
  createdAt              DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                   @default(now()) @db.Timestamptz(3)
  completedAt            DateTime?                  @db.Timestamptz(3)
  failedAt               DateTime?                  @db.Timestamptz(3)
}

model CertificateBatch {
  id                  String    @id @default(uuid()) @db.Uuid
  eventId             String    @db.Uuid
  requestedByUserId   String    @db.Uuid
  acceptanceSessionId String    @db.Uuid
  commandReplayId     String    @unique @db.Uuid
  correlationId       String    @db.VarChar(64)
  templateId          String    @db.VarChar(16)
  templateVersion     Int       @db.SmallInt
  fontId              String    @db.VarChar(8)
  status              String    @default("PENDING") @db.VarChar(16)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  startedAt           DateTime? @db.Timestamptz(3)
  completedAt         DateTime? @db.Timestamptz(3)

  @@index([status, createdAt, id])
}

model CertificateBatchItem {
  id                 String  @id @default(uuid()) @db.Uuid
  batchId            String  @db.Uuid
  eventId            String  @db.Uuid
  registrationId     String  @db.Uuid
  eligibleAtCreation Boolean
  status             String  @default("PENDING") @db.VarChar(16)
  issueWorkId        String? @db.Uuid
  generationCycle    Int?
  certificateId      String? @db.Uuid
  resultCode         String? @db.VarChar(80)

  @@unique([batchId, registrationId])
  @@index([issueWorkId, generationCycle])
  @@index([status, batchId, registrationId])
}

model CertificateDelivery {
  id            String    @id @default(uuid()) @db.Uuid
  certificateId String    @unique @db.Uuid
  eventId       String    @db.Uuid
  status        String    @default("PENDING") @db.VarChar(16)
  reasonCode    String?   @db.VarChar(80)
  attemptCount  Int       @default(0)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @db.Timestamptz(3)
  lastAttemptAt DateTime? @db.Timestamptz(3)
  sentAt        DateTime? @db.Timestamptz(3)

  @@index([status, createdAt, id])
}

model CertificateDeliveryAttempt {
  id                 String    @id @default(uuid()) @db.Uuid
  deliveryId         String    @db.Uuid
  attemptNumber      Int       @db.SmallInt
  status             String    @default("PENDING") @db.VarChar(16)
  recipientUserId    String?   @db.Uuid
  recipientContactId String?   @db.Uuid
  encryptedRecipient String?
  claimToken         String?   @db.Uuid
  fencingToken       BigInt    @default(0)
  leaseExpiresAt     DateTime? @db.Timestamptz(3)
  reasonCode         String?   @db.VarChar(80)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  startedAt          DateTime? @db.Timestamptz(3)
  completedAt        DateTime? @db.Timestamptz(3)

  @@unique([deliveryId, attemptNumber])
  @@index([status, leaseExpiresAt, id])
}

model ForecastRun {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @db.Uuid
  persistedAt DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)
  result      Json
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@index([eventId, persistedAt(sort: Desc), id(sort: Desc)])
}

model Gate {
  id                    String                 @id @default(uuid()) @db.Uuid
  eventId               String                 @db.Uuid
  event                 Event                  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  assignments           EventRoleAssignment[]  @relation("AssignmentGate")
  scanDecisions         ScanDecision[]
  attendanceTransitions AttendanceTransition[]

  @@unique([eventId, id])
  @@index([eventId])
}

model EventRoleAssignment {
  id              String    @id @default(uuid()) @db.Uuid
  eventId         String    @db.Uuid
  userId          String    @db.Uuid
  role            StaffRole
  gateId          String?   @db.Uuid
  scopeKey        String    @db.VarChar(40)
  grantedByUserId String    @db.Uuid
  grantedAt       DateTime  @default(now()) @db.Timestamptz(3)
  revokedByUserId String?   @db.Uuid
  revokedAt       DateTime? @db.Timestamptz(3)
  event           Event     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  user            User      @relation("AssignmentTarget", fields: [userId], references: [id], onDelete: Restrict)
  gate            Gate?     @relation("AssignmentGate", fields: [eventId, gateId], references: [eventId, id], onDelete: Restrict)
  grantedBy       User      @relation("AssignmentGrantActor", fields: [grantedByUserId], references: [id], onDelete: Restrict)
  revokedBy       User?     @relation("AssignmentRevokeActor", fields: [revokedByUserId], references: [id], onDelete: Restrict)

  @@index([userId, eventId, revokedAt])
  @@index([eventId, role, revokedAt])
  @@index([eventId, gateId, revokedAt])
}

model AuditEvent {
  id            String         @id @default(uuid()) @db.Uuid
  actorKind     AuditActorKind
  actorUserId   String?        @db.Uuid
  eventId       String?        @db.Uuid
  targetUserId  String?        @db.Uuid
  action        String         @db.VarChar(80)
  outcome       String         @db.VarChar(24)
  correlationId String         @db.VarChar(64)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  metadata      Json?

  @@index([eventId, createdAt])
  @@index([eventId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([actorUserId, createdAt])
}

model PrivateAccessLink {
  id                 String             @id @default(uuid()) @db.Uuid
  eventId            String             @db.Uuid
  verifierHash       String             @unique @db.Char(64)
  verifierKeyVersion Int                @default(1) @db.SmallInt
  issuedAt           DateTime           @default(now()) @db.Timestamptz(3)
  revokedAt          DateTime?          @db.Timestamptz(3)
  replacesLinkId     String?            @unique @db.Uuid
  event              Event              @relation(fields: [eventId], references: [id], onDelete: Restrict)
  replacesLink       PrivateAccessLink? @relation("PrivateLinkReplacement", fields: [replacesLinkId], references: [id], onDelete: Restrict)
  replacementLink    PrivateAccessLink? @relation("PrivateLinkReplacement")

  @@index([eventId, issuedAt(sort: Desc)])
}

model CommandReplay {
  id                          String              @id @default(uuid()) @db.Uuid
  actorUserId                 String?             @db.Uuid
  actorGuestIdentityId        String?             @db.Uuid
  action                      String              @db.VarChar(80)
  resourceKey                 String              @db.VarChar(120)
  idempotencyKeyHash          String              @db.Char(64)
  requestFingerprint          String              @db.Char(64)
  status                      CommandReplayStatus @default(PENDING)
  responseStatus              Int?                @db.SmallInt
  responseBody                Json?
  protectedResponse           Bytes?
  protectedResponseKeyVersion Int?                @db.SmallInt
  protectedReplayExpiresAt    DateTime?           @db.Timestamptz(3)
  createdAt                   DateTime            @default(now()) @db.Timestamptz(3)
  completedAt                 DateTime?           @db.Timestamptz(3)
  expiresAt                   DateTime            @db.Timestamptz(3)
  actor                       User?               @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  guestActor                  GuestIdentity?      @relation(fields: [actorGuestIdentityId], references: [id], onDelete: Restrict)

  @@unique([actorUserId, action, resourceKey, idempotencyKeyHash], map: "CommandReplay_actor_action_resource_key_key")
  @@unique([actorGuestIdentityId, action, resourceKey, idempotencyKeyHash], map: "CommandReplay_guest_action_resource_key_key")
  @@index([expiresAt])
}

model GuestIdentity {
  id             String          @id @default(uuid()) @db.Uuid
  lookupHash     String          @unique @db.Char(64)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  registrations  Registration[]
  commandReplays CommandReplay[]
}

model Registration {
  id                     String                 @id @default(uuid()) @db.Uuid
  eventId                String                 @db.Uuid
  userId                 String?                @db.Uuid
  guestIdentityId        String?                @db.Uuid
  state                  RegistrationState      @default(REGISTERED)
  createdAt              DateTime               @default(now()) @db.Timestamptz(3)
  cancelledAt            DateTime?              @db.Timestamptz(3)
  cancelledByUserId      String?                @db.Uuid
  cancelledActorKind     AuditActorKind?
  firstAcceptedCheckInAt DateTime?              @db.Timestamptz(3)
  event                  Event                  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  user                   User?                  @relation("RegistrationOwner", fields: [userId], references: [id], onDelete: Restrict)
  guest                  GuestIdentity?         @relation(fields: [guestIdentityId], references: [id], onDelete: Restrict)
  cancelledBy            User?                  @relation("RegistrationCancelActor", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  credentials            QRCredential[]
  scanDecisions          ScanDecision[]
  attendanceTransitions  AttendanceTransition[]

  @@unique([eventId, id])
  @@index([eventId, state])
  @@index([userId, eventId, createdAt(sort: Desc)])
  @@index([guestIdentityId, eventId, createdAt(sort: Desc)])
}

model QRCredential {
  id                      String         @id @default(uuid()) @db.Uuid
  registrationId          String         @db.Uuid
  verifierHash            String         @unique @db.Char(64)
  keyVersion              Int            @default(1) @db.SmallInt
  protectedRepresentation Bytes?
  issuedAt                DateTime       @default(now()) @db.Timestamptz(3)
  expiresAt               DateTime?      @db.Timestamptz(3)
  revokedAt               DateTime?      @db.Timestamptz(3)
  registration            Registration   @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  scanDecisions           ScanDecision[]

  @@unique([registrationId, id])
  @@index([registrationId])
}

model ScanDecision {
  id             String                @id @default(uuid()) @db.Uuid
  scanId         String                @db.Uuid
  eventId        String                @db.Uuid
  gateId         String                @db.Uuid
  operatorUserId String                @db.Uuid
  registrationId String?               @db.Uuid
  credentialId   String?               @db.Uuid
  decision       ScanOutcome
  reason         String                @db.VarChar(40)
  decidedAt      DateTime              @db.Timestamptz(3)
  correlationId  String                @db.VarChar(64)
  event          Event                 @relation(fields: [eventId], references: [id], onDelete: Restrict)
  gate           Gate                  @relation(fields: [eventId, gateId], references: [eventId, id], onDelete: Restrict)
  operator       User                  @relation(fields: [operatorUserId], references: [id], onDelete: Restrict)
  registration   Registration?         @relation(fields: [eventId, registrationId], references: [eventId, id], onDelete: Restrict)
  credential     QRCredential?         @relation(fields: [registrationId, credentialId], references: [registrationId, id], onDelete: Restrict)
  attendance     AttendanceTransition?

  @@unique([operatorUserId, gateId, scanId])
  @@index([eventId, gateId, decidedAt])
}

model AttendanceTransition {
  id             String         @id @default(uuid()) @db.Uuid
  eventId        String         @db.Uuid
  gateId         String         @db.Uuid
  operatorUserId String         @db.Uuid
  registrationId String         @unique @db.Uuid
  scanDecisionId String         @unique @db.Uuid
  kind           AttendanceKind @default(CHECK_IN)
  acceptedAt     DateTime       @db.Timestamptz(3)
  event          Event          @relation(fields: [eventId], references: [id], onDelete: Restrict)
  gate           Gate           @relation(fields: [eventId, gateId], references: [eventId, id], onDelete: Restrict)
  operator       User           @relation(fields: [operatorUserId], references: [id], onDelete: Restrict)
  registration   Registration   @relation(fields: [eventId, registrationId], references: [eventId, id], onDelete: Restrict)
  scanDecision   ScanDecision   @relation(fields: [scanDecisionId], references: [id], onDelete: Restrict)

  @@index([eventId, acceptedAt])
}
