{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd /d /c \"set GRAPHIFY_NO_AUTO_REFRESH=1&& set GRAPHIFY_QUERY_LOG_DISABLE=1&& .tools\\graphify\\Scripts\\graphify.exe hook-check\""
          }
        ]
      }
    ]
  }
}
