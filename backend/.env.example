PORT=3000
FRONTEND_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgresql://eoc_test:replace-with-local-password@127.0.0.1:5432/eoc_slice2
# Generate three independent random 32-byte hex keys locally; never commit real values.
JWT_SECRET=replace-with-64-hex-characters
CONTACT_KEY=replace-with-64-hex-characters
OTP_KEY=replace-with-64-hex-characters
# SMTP_URL=smtp://127.0.0.1:1025
# Optional forecasting service. Both are required together; use a fourth independent key.
# HTTP is allowed only on loopback; remote connections require HTTPS.
# FORECAST_SERVICE_URL=http://127.0.0.1:8000
# FORECAST_SERVICE_KEY=replace-with-64-hex-characters
# SMTP_FROM=no-reply@example.test
# Optional absolute path to a deployment-provided ESM module whose default export implements sendSms(destination, message).
# SMS_GATEWAY_MODULE=C:\absolute\path\to\android-sms-adapter.mjs
# Slice 12: production requires an exact HTTPS origin; BIND_HOST=0.0.0.0
# publishes only through the TLS edge. Mounted secrets use DATABASE_URL_FILE,
# JWT_SECRET_FILE, CONTACT_KEY_FILE, OTP_KEY_FILE, FORECAST_SERVICE_KEY_FILE,
# SMTP_URL_FILE, METRICS_TOKEN_FILE (never both environment and file sources).
# Demo: DB_POOL_MAX=25, TELEMETRY_ENABLED=true, TRACE_SAMPLE_RATIO=0.1.
