{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run --environment node",
    "build": "tsc --project tsconfig.build.json"
  },
  "dependencies": {
    "cors": "2.8.6",
    "express": "5.2.1",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.0",
    "tsx": "4.23.15"
  }
}
