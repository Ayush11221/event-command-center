{
  "openapi": "3.1.0",
  "info": {
    "title": "Event Command Center - Slice 4 implemented operations",
    "version": "1.0.0",
    "description": "Additive participant registration and owner QR contract. Slice 3 operations remain in SLICE_3_OPENAPI.json. No scanner, attendance, occupancy or standalone credential reissue."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/events/{eventId}/registrations": {
      "post": {
        "operationId": "createRegistration",
        "summary": "Create own registration and protected QR atomically.",
        "security": [
          {
            "AccountCookie": []
          },
          {
            "GuestCookie": []
          }
        ],
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^PrivateLink [A-Za-z0-9_-]{43}$"
            },
            "description": "Current PRIVATE Published event bearer proof required for new PRIVATE registration; no proof in URL, query or body."
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 200,
              "pattern": "^[!-~]+$"
            },
            "description": "Reuse exact key/body on unknown outcomes. Secret-free replay retention is seven days; current authority checked before replay."
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Configured frontend Origin."
          }
        ],
        "responses": {
          "201": {
            "description": "Success",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "private, no-store"
              },
              "Referrer-Policy": {
                "schema": {
                  "type": "string",
                  "enum": ["no-referrer"]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationResult"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "private, no-store"
              },
              "Referrer-Policy": {
                "schema": {
                  "type": "string",
                  "enum": ["no-referrer"]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN/CSRF_INVALID; cancellation also FRESH_GUEST_PROOF_REQUIRED",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "private, no-store"
              },
              "Referrer-Policy": {
                "schema": {
                  "type": "string",
                  "enum": ["no-referrer"]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Privacy-safe EVENT_NOT_FOUND on event routes, REGISTRATION_NOT_FOUND on registration routes",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "private, no-store"
              },
              "Referrer-Policy": {
                "schema": {
                  "type": "string",
                  "enum": ["no-referrer"]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "DEPENDENCY_UNAVAILABLE; required database/audit fail closed",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "private, no-store"
              },
              "Referrer-Policy": {
                "schema": {
                  "type": "string",
                  "enum": ["no-referrer"]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
