  "components": {
    "schemas": {
      "Batch": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "batch_id",
          "event_id",
          "status",
          "template_id",
          "template_version",
          "font_id",
          "selected_count",
          "eligible_count",
          "generated_count",
          "already_satisfied_count",
          "successful_count",
          "failed_count",
          "pending_count",
          "delivery_counts",
          "created_at",
          "started_at",
          "completed_at"
