          "template_version": {
            "type": "integer",
            "const": 1
          },
          "font_id": {
            "type": "string",
            "enum": ["sans", "serif"]
          },
          "selected_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "eligible_count": {
            "type": "integer",
            "minimum": 0
          },
          "generated_count": {
            "type": "integer",
            "minimum": 0
          },
          "already_satisfied_count": {
            "type": "integer",
            "minimum": 0
          },
          "successful_count": {
            "type": "integer",
            "minimum": 0
          },
          "failed_count": {
            "type": "integer",
            "minimum": 0
          },
          "pending_count": {
            "type": "integer",
            "minimum": 0
          },
          "delivery_counts": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "not_required",
              "pending",
              "sending",
              "sent",
              "unknown",
              "failed"
            ],
            "properties": {
              "not_required": {
                "type": "integer",
                "minimum": 0
              },
              "pending": {
                "type": "integer",
                "minimum": 0
              },
              "sending": {
                "type": "integer",
                "minimum": 0
              },
              "sent": {
                "type": "integer",
                "minimum": 0
              },
              "unknown": {
                "type": "integer",
                "minimum": 0
              },
              "failed": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "started_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "completed_at": {
            "type": ["string", "null"],
            "format": "date-time"
          }
        }
      },
      "Item": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "registration_id",
          "status",
          "issue_work_id",
          "certificate_id",
          "result_code"
