            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "last_attempt_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "sent_at": {
            "type": ["string", "null"],
            "format": "date-time"
          }
        }
      },
      "BatchRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "registration_ids",
          "template_id",
          "template_version",
          "font_id"
