            "maxItems": 100,
            "uniqueItems": true
          },
          "template_id": {
            "type": "string",
            "enum": ["classic", "modern", "minimal"]
          },
          "template_version": {
            "type": "integer",
            "const": 1
          },
          "font_id": {
            "type": "string",
            "enum": ["sans", "serif"]
          }
        }
      },
