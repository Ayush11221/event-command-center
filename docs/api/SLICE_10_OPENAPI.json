        "properties": {
          "batch_id": {
            "type": "string",
            "format": "uuid"
          },
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "RUNNING",
              "COMPLETED",
              "PARTIAL_FAILED",
              "FAILED"
            ]
          },
          "template_id": {
            "type": "string",
            "enum": ["classic", "modern", "minimal"]
